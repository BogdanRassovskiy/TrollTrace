# Скопируйте в .env и заполните. .env не коммитится.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Временно: доступ без входа (в dev по умолчанию true). Для включения защиты — false.
OPEN_ACCESS=true

# PostgreSQL + pgvector
POSTGRES_DB=trolltrace
POSTGRES_USER=trolltrace
POSTGRES_PASSWORD=trolltrace
DATABASE_URL=postgres://trolltrace:trolltrace@localhost:5432/trolltrace

# Redis (брокер Celery)
REDIS_URL=redis://localhost:6379/0

# User-agent исследовательского бота (README §4)
CRAWLER_USER_AGENT=TrollTraceResearchBot/0.1 (+mailto:change-me@example.org)

# Telegram-бот для уведомлений о поломках сбора (README §4.2); пусто — только панель
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Разметка нарративов (этап 6): ключ OpenRouter (https://openrouter.ai/keys). Пусто — кандидаты ждут.
OPENROUTER_API_KEY=
SITE_URL=http://localhost:8000

# Доступ извне через Tailscale (README «Доступ через Tailscale»): адрес из `tailscale serve`.
# SITE_URL=https://<pocitac>.<tailnet>.ts.net
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<pocitac>.<tailnet>.ts.net
# При доступе извне — всегда OPEN_ACCESS=false (вход по паролю).
