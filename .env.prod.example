# Продакшен: скопируйте в .env.prod на сервере и заполните. Файл не коммитится.
DJANGO_SECRET_KEY=change-me-long-random
DJANGO_ALLOWED_HOSTS=trolltrace.example.cz
DJANGO_CSRF_TRUSTED_ORIGINS=https://trolltrace.example.cz
SITE_DOMAIN=trolltrace.example.cz
SITE_URL=https://trolltrace.example.cz

# Вход обязателен (полные тексты — закрытая среда, README §6). true — открыть всем.
OPEN_ACCESS=false

POSTGRES_DB=trolltrace
POSTGRES_USER=trolltrace
POSTGRES_PASSWORD=change-me-long-random

CRAWLER_USER_AGENT=TrollTraceResearchBot/0.1 (+mailto:change-me@example.org)

# Уведомления о поломках сбора
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Внешний мониторинг (healthchecks.io и т. п.): тревога, если сбор или бэкапы остановились
HEARTBEAT_PING_URL=
BACKUP_PING_URL=

# Бэкапы: каталог на хосте, срок хранения (дней), час запуска (UTC)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
